<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.91.0" />
    <PackageReference Include="Microsoft.Identity.Web.TokenCache" Version="4.16.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Pkcs/Xml lift the vulnerable 10.0.10 that Microsoft.Identity.Web.TokenCache pulls in
         transitively (GHSA-846f-f764-76mx, GHSA-r955-8q5j-3h83, GHSA-c399-9853-6jmj). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

</Project>
